# Copy to .env and adjust. Real environment variables take precedence.

# Database. Default: SQLite file under CLIPMAKER_DATA_DIR.
# PostgreSQL example: postgresql+psycopg://user:pass@localhost:5432/clipmaker
DATABASE_URL=sqlite:///./data/clipmaker.db

# Where uploads, renders and the SQLite file live.
CLIPMAKER_DATA_DIR=./data

# Downloaded models (git-ignored).
CLIPMAKER_CACHE_DIR=./.cache

# Web server
CLIPMAKER_HOST=127.0.0.1
CLIPMAKER_PORT=8000
# Run the background job worker inside the web process (0 to disable).
CLIPMAKER_WORKER=1
# Largest accepted upload, in MB.
CLIPMAKER_MAX_UPLOAD_MB=4096
# Delete projects this many hours after upload (0 = keep forever) and keep this many GB of
# disk free by deleting the oldest projects first (0 = off). The server kit sets 24 and 10.
# CLIPMAKER_RETENTION_HOURS=0
# CLIPMAKER_MIN_FREE_GB=0
# Longest uploaded video in minutes (0 = no limit; links are always capped at 60)
# CLIPMAKER_MAX_UPLOAD_MINUTES=0
# Public server (D-030): each visitor sees only their own projects (1 = on) and may start N videos
# per 24 h (0 = no limit). The server kit sets 1 and 5. Cookie signing key (default: <data>/secret_key):
# CLIPMAKER_PRIVATE=0
# CLIPMAKER_DAILY_LIMIT=0
# Re-renders of edited clips per project (D-031; 0 = no limit, the server kit sets 20):
# CLIPMAKER_MAX_EDITS=0
# CLIPMAKER_SECRET_KEY=

# Optional LLM re-ranking of clips (off by default; sends clip transcripts to Anthropic).
# CLIPMAKER_LLM_SCORING=1
# ANTHROPIC_API_KEY=
# CLIPMAKER_LLM_MODEL=claude-haiku-4-5

# Whisper size for Hebrew and other non-English speech (and language detection): tiny | base | small
# CLIPMAKER_WHISPER_MODEL=base
# Parallel speech recognizers (default: one per CPU core, max 4; D-021)
# CLIPMAKER_ASR_WORKERS=2
# English speech engine: moonshine-base (default, ~2x faster) | moonshine-tiny | whisper
# CLIPMAKER_EN_ENGINE=moonshine-base

# Clip rendering: parallel workers (default: one per CPU core, max 4) and x264 preset
# CLIPMAKER_RENDER_WORKERS=2
# CLIPMAKER_X264_PRESET=superfast

# YouTube/Twitch links via yt-dlp (D-019). All optional; they help when YouTube shows
# "Sign in to confirm you're not a bot" on server IPs. Check with: clipmaker platform-check
# PO-token provider (Docker: brainicism/bgutil-ytdlp-pot-provider on 127.0.0.1:4416,
# plus `pip install bgutil-ytdlp-pot-provider` next to yt-dlp):
# CLIPMAKER_YTDLP_POT_URL=http://127.0.0.1:4416
# cookies.txt (Netscape format) exported from an account you control; never commit it:
# CLIPMAKER_YTDLP_COOKIES=/data/secrets/youtube-cookies.txt
# CLIPMAKER_YTDLP_PROXY=http://user:pass@proxy.example:8080
# JavaScript runtime for YouTube's player challenges: deno (yt-dlp default) | node
# CLIPMAKER_YTDLP_JS_RUNTIME=node
# Retries after a transient failure (rate limit, 5xx, network, bot check) and the first pause in s (x3 each time)
# CLIPMAKER_YTDLP_RETRIES=2
# CLIPMAKER_YTDLP_RETRY_WAIT=10
