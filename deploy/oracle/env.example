# Server settings for deploy/oracle/compose.yml. setup.sh copies this to deploy/oracle/.env.
# Never commit .env.

# Public name of the site. Leave empty and setup.sh uses <public-ip-with-dashes>.sslip.io,
# a free name that points to your IP, so HTTPS works without buying a domain.
CLIPMAKER_DOMAIN=

# Where the database, uploads and clips live on the server's disk
CLIPMAKER_DATA_PATH=/srv/clipmaker/data

# Largest accepted upload, in MB
CLIPMAKER_MAX_UPLOAD_MB=2048
# Two ARM cores: one render worker and one speech recognizer per core
CLIPMAKER_RENDER_WORKERS=2
CLIPMAKER_ASR_WORKERS=2

# Only if YouTube still shows its bot check (H-007 step 2); the path is inside the container:
# put the file at $CLIPMAKER_DATA_PATH/secrets/youtube-cookies.txt
# CLIPMAKER_YTDLP_COOKIES=/data/secrets/youtube-cookies.txt
# CLIPMAKER_YTDLP_PROXY=
